    "@cuelingo/prompts": "workspace:*",
    "@cuelingo/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/websocket": "^11.3.6",
    "better-auth": "^1.7.14",
    "fastify": "^5.12.7",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
