{
  "name": "@cuelingo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "enqueue": "tsx --env-file-if-exists=../../.env src/scripts/enqueue.ts",
    "invite:create": "tsx --env-file-if-exists=../../.env src/scripts/invite.ts"
  },
  "dependencies": {
    "@cuelingo/ai-gateway": "workspace:*",
