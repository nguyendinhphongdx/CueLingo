{
  "name": "@cuelingo/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --port 3000",
    "dev:turbo": "next dev --port 3000",
    "build": "next build --webpack",
    "build:static": "node scripts/check-env.mjs --production && NEXT_STATIC_EXPORT=true next build --webpack && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/write-headers.mjs",
    "scan:static": "node scripts/scan-out.mjs",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@cuelingo/core-sdk": "workspace:*",
    "@cuelingo/shared": "workspace:*",
    "@cuelingo/ui": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "better-auth": "^1.7.14",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  }
}
