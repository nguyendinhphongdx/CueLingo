{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CueLingo",
  "version": "0.1.2",
  "identifier": "vn.cmcai.cuelingo",
  "build": {
    "beforeDevCommand": "node scripts/sidecar.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/sidecar.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CueLingo",
        "url": "index.html",
        "width": 1000,
        "height": 680,
        "visible": true,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "overlay",
        "title": "CueLingo overlay",
        "url": "overlay.html",
        "width": 520,
        "height": 520,
        "minWidth": 320,
        "minHeight": 200,
        "resizable": true,
        "center": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "contentProtected": true,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Trợ lý caption song ngữ cho cuộc họp tiếng Anh",
    "longDescription": "CueLingo hiện caption tiếng Anh kèm bản dịch tiếng Việt theo thời gian thực trên mọi cuộc họp, giúp bạn tra từ nhanh, soạn câu trả lời, và học lại từ chính cuộc họp của mình.",
    "copyright": "© 2026 CMC AI",
    "publisher": "CMC AI",
    "macOS": {
      "minimumSystemVersion": "14.2",
      "signingIdentity": "-"
    },
    "externalBin": ["binaries/cuelingo-audio"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["cuelingo"]
      }
    }
  }
}
