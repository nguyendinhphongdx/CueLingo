{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm verify)",
      "Bash(pnpm build)",
      "Bash(pnpm dev)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm check:deps)",
      "Bash(pnpm docs:dev)",
      "Bash(pnpm docs:build)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter * dev)",
      "Bash(pnpm --filter * build)",
      "Bash(pnpm --filter * add *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm vitest *)",
      "Bash(npx tsc *)",
      "Bash(turbo *)",
      "Bash(cargo fmt*)",
      "Bash(cargo clippy*)",
      "Bash(cargo check*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash(git stash list)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir -p *)",
      "Bash(cp -r *)",
      "Read(*)",
      "Edit(apps/**)",
      "Edit(services/**)",
      "Edit(packages/**)",
      "Edit(docs/**)",
      "Edit(ml/**)",
      "Edit(.claude/skills/**)",
      "Edit(.claude/agents/**)",
      "Edit(.claude/commands/**)",
      "Edit(AGENTS.md)",
      "Edit(README.md)",
      "Write(apps/**)",
      "Write(services/**)",
      "Write(packages/**)",
      "Write(docs/**)",
      "Write(ml/**)",
      "Write(infra/db/migrations/**)"
    ],
    "deny": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(yarn *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git branch -D *)",
      "Bash(rm -rf /*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Edit(pnpm-lock.yaml)",
      "Write(pnpm-lock.yaml)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git tag*)",
      "Bash(gh pr *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(docker *)",
      "Edit(infra/db/migrations/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Edit(eslint.config.mjs)",
      "Edit(.dependency-cruiser.cjs)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.mjs"
          }
        ]
      }
    ]
  }
}
