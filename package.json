{
  "name": "cuelingo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:deps": "depcruise apps services packages --config .dependency-cruiser.cjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:deps",
    "prepare": "husky",
    "docs:dev": "pnpm --filter @cuelingo/docs dev",
    "docs:build": "pnpm --filter @cuelingo/docs build",
    "db:new": "dbmate --migrations-dir infra/db/migrations new",
    "db:migrate": "dbmate --migrations-dir infra/db/migrations --no-dump-schema up",
    "db:rollback": "dbmate --migrations-dir infra/db/migrations --no-dump-schema rollback",
    "db:status": "dbmate --migrations-dir infra/db/migrations status",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "dbmate": "^2.37.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
