# Same values as headers.mjs, for static hosts that read a _headers file (Cloudflare Pages, Netlify).
# Replace https://app.example.com with the origin of the web app; several origins are space separated.
/runner.html
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; media-src data: blob:; font-src data:; connect-src 'none'; frame-src 'self' about:; form-action 'none'; base-uri 'none'; frame-ancestors https://app.example.com
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), clipboard-read=(), clipboard-write=(), fullscreen=()
  Cache-Control: no-cache
