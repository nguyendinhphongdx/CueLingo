# Copy to infra/.env.tunnel (gitignored) and fill in. Keep it readable by you only:  chmod 600 infra/.env.tunnel
# Never paste these values into chat, issues or commits.

# --- Domain (change both here when the domain changes) ---
# Web address people open (must match the Cloudflare Pages custom domain), no trailing slash.
WEB_ORIGIN=https://cuelingo.example.com
# Public address of this API: the Public Hostname of the tunnel. Same registrable domain as the web.
BETTER_AUTH_URL=https://api-cuelingo.example.com

# --- Cloudflare Tunnel ---
# Token from Zero Trust > Networks > Tunnels > your tunnel > Install. The Public Hostname must point at http://api:4000 (Service URL, with the http://)
TUNNEL_TOKEN=

# --- Database ---
# Any long random string:  openssl rand -base64 24   (letters and digits are safest; it goes inside a URL)
POSTGRES_PASSWORD=

# --- Sign-in ---
# At least 32 characters:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# production refuses MAIL_PROVIDER=console. resend needs RESEND_API_KEY and MAIL_FROM; smtp needs SMTP_URL and MAIL_FROM.
MAIL_PROVIDER=resend
MAIL_FROM=
RESEND_API_KEY=
SMTP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI ---
GEMINI_API_KEY=
# Keep false until testers are invited (the assistant costs money per message).
AGENT_ENABLED=false
AI_AGENT_MODEL=

# --- People ---
# Comma-separated emails allowed to open /admin/metrics.
ADMIN_EMAILS=
# true: a new account needs an invite code. false: anyone can sign up with an email link.
INVITES_REQUIRED=true

# --- Backups ---
# Folder on the host for pg_dump files (relative paths are relative to infra/). Point it at another disk if you can.
BACKUP_DIR=./backups
BACKUP_KEEP=7
BACKUP_INTERVAL_SECONDS=86400
