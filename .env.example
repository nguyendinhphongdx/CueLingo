# Copy to .env (gitignored). Read once by services/api/src/config.ts.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://cuelingo:cuelingo@localhost:5432/cuelingo?sslmode=disable

# Better Auth (services/api). Secret: at least 32 chars, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Google sign-in is optional; set both or neither.
# --- Email đăng nhập (magic link) ---
# console: chỉ in link ra log API, dùng khi phát triển. Production bắt buộc resend hoặc smtp.
MAIL_PROVIDER=console
# Người gửi hiển thị cho người nhận; tên miền phải được nhà cung cấp xác minh. Ví dụ: CueLingo <login@ten-mien-cua-ban.com>
MAIL_FROM=
# MAIL_PROVIDER=resend: khoá API lấy ở resend.com/api-keys
RESEND_API_KEY=
# MAIL_PROVIDER=smtp: ví dụ smtps://tai-khoan:mat-khau@smtp.nha-cung-cap.com:465
SMTP_URL=

# --- Đăng nhập Google (tuỳ chọn, đặt cả hai hoặc không đặt) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Live-caption translation. Without GEMINI_API_KEY the realtime route is disabled.
GEMINI_API_KEY=

# Development-only WebSocket token. If REALTIME_DEV_USER_ID is empty, the first learner profile is used.
# Token must contain at least 16 characters; user id must be a UUID.
REALTIME_DEV_TOKEN=
REALTIME_DEV_USER_ID=

# Email được phép xem /admin/metrics, phân cách bằng dấu phẩy. Để trống thì không ai được phép.
ADMIN_EMAILS=

# Giọng đọc: nơi lưu file âm thanh đã tạo (mặc định thư mục tạm của hệ thống)
TTS_CACHE_DIR=

# --- Bài học theo mục tiêu ---
# Mở bài mới và luyện câu (gọi AI). Mặc định: TẮT ở production, BẬT ở dev/test. Chỉ bật ở production sau khi chạy
# `pnpm eval:lesson` với model thật và ghi số liệu vào hồ sơ goal-lessons.
# Danh sách mục tiêu và bài đã mở vẫn dùng được khi tắt. Model: AI_LESSON_MODEL, AI_LESSON_FALLBACK_MODEL (feedback).
GOAL_LESSONS_ENABLED=

# --- Trợ lý AI (agent) ---
# false (hoặc thiếu GEMINI_API_KEY) thì POST /v1/conversations/:id/messages trả 503 AGENT_DISABLED.
AGENT_ENABLED=true
# Khối giao diện HTML/JS do AI sinh (tool render_html, prompt agent/v2). Mặc định TẮT. Chỉ bật khi sandbox runner
# (infra/sandbox-runner) đã chạy ở origin riêng và web đặt NEXT_PUBLIC_AGENT_HTML_BLOCKS=true + NEXT_PUBLIC_SANDBOX_ORIGIN.
# Production: runner cần registrable domain RIÊNG (không phải subdomain của app); web từ chối origin trùng API/trang.
# Giữ TẮT cho bản Tauri tới khi kiểm WKWebView. Xem ADR 0019.
AGENT_HTML_BLOCKS=false
# Web (build time): hiện khối giao diện của trợ lý. Cần cả hai; thiếu một thì web chỉ hiện "chưa bật".
NEXT_PUBLIC_AGENT_HTML_BLOCKS=false
NEXT_PUBLIC_SANDBOX_ORIGIN=http://localhost:3101
# Model của trợ lý (task agent.chat); để trống dùng mặc định trong packages/ai-gateway/src/tasks.ts
AI_AGENT_MODEL=
# Hạn mức mỗi người mỗi ngày UTC: số lượt, token, USD
AGENT_QUOTA_TURNS_PER_DAY=60
AGENT_QUOTA_TOKENS_PER_DAY=400000
AGENT_QUOTA_USD_PER_DAY=0.25

# --- Trợ lý trong cuộc họp (ADR 0027) ---
# Gửi nội dung cuộc họp tới nhà cung cấp AI cho mục đích mới nên mặc định TẮT. false (hoặc thiếu GEMINI_API_KEY)
# thì POST /v1/sessions/:id/questions trả 503 MEETING_ASSIST_DISABLED.
MEETING_ASSIST_ENABLED=false
# Để trống dùng mặc định trong packages/ai-gateway/src/tasks.ts
AI_MEETING_ASK_MODEL=
AI_MEETING_ASK_FALLBACK_MODEL=

# --- Gói và hạn mức (Free/Pro/Ultra) ---
# JSON ghi đè từng phần lên bảng mặc định trong packages/shared/src/plans.ts; để trống dùng mặc định.
# Khoá: free|pro|ultra -> translation_ms, cloud_stt_ms (mili giây), debriefs, assist_daily, agent_messages (số lần);
# null = không giới hạn. Ví dụ thử nhanh: {"free":{"translation_ms":600000,"debriefs":2}}
# Sai định dạng thì API không khởi động. Worker đọc cùng biến này (kiểm debrief của phiên bị bỏ dở).
PLAN_LIMITS=

# Nâng gói bằng VietQR qua PayOS (ADR 0023). Đặt cả ba khoá hoặc để trống cả ba (trống = ẩn nút "Nâng gói").
# Khoá lấy ở dashboard PayOS; không commit khoá thật. Webhook: pnpm --filter @cuelingo/api billing:confirm-webhook
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# JSON ghi đè giá VND (chỉ API đọc), ví dụ thử tiền thật: {"pro":{"month":2000}}. Trống = giá mặc định
# (Pro 99.000/990.000, Ultra 249.000/2.490.000 cho tháng/năm).
PLAN_PRICES=
