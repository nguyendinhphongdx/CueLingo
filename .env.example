# Copy to .env (gitignored). Read once by services/api/src/config.ts.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://cuelingo:cuelingo@localhost:5432/cuelingo?sslmode=disable

# Better Auth (services/api). Secret: at least 32 chars, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Google sign-in is optional; set both or neither.
# --- Email đăng nhập (magic link) ---
# console: chỉ in link ra log API, dùng khi phát triển. Production bắt buộc resend hoặc smtp.
MAIL_PROVIDER=console
# Người gửi hiển thị cho người nhận; tên miền phải được nhà cung cấp xác minh. Ví dụ: CueLingo <login@ten-mien-cua-ban.com>
MAIL_FROM=
# MAIL_PROVIDER=resend: khoá API lấy ở resend.com/api-keys
RESEND_API_KEY=
# MAIL_PROVIDER=smtp: ví dụ smtps://tai-khoan:mat-khau@smtp.nha-cung-cap.com:465
SMTP_URL=

# --- Đăng nhập Google (tuỳ chọn, đặt cả hai hoặc không đặt) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Live-caption translation. Without GEMINI_API_KEY the realtime route is disabled.
GEMINI_API_KEY=

# Development-only WebSocket token. If REALTIME_DEV_USER_ID is empty, the first learner profile is used.
# Token must contain at least 16 characters; user id must be a UUID.
REALTIME_DEV_TOKEN=
REALTIME_DEV_USER_ID=

# Email được phép xem /admin/metrics, phân cách bằng dấu phẩy. Để trống thì không ai được phép.
ADMIN_EMAILS=

# Giọng đọc: nơi lưu file âm thanh đã tạo (mặc định thư mục tạm của hệ thống)
TTS_CACHE_DIR=

# --- Trợ lý AI (agent) ---
# false (hoặc thiếu GEMINI_API_KEY) thì POST /v1/conversations/:id/messages trả 503 AGENT_DISABLED.
AGENT_ENABLED=true
# Model của trợ lý (task agent.chat); để trống dùng mặc định trong packages/ai-gateway/src/tasks.ts
AI_AGENT_MODEL=
# Hạn mức mỗi người mỗi ngày UTC: số lượt, token, USD
AGENT_QUOTA_TURNS_PER_DAY=60
AGENT_QUOTA_TOKENS_PER_DAY=400000
AGENT_QUOTA_USD_PER_DAY=0.25
